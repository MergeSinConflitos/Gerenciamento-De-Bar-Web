@{
    Layout = "_Layout";

    ViewBag.Titulo = "Página Inicial";

    bool logado = User.Identity?.IsAuthenticated == true;
}


<style>
    /* =========================================================
       HERO
       ========================================================= */

    .hero-bar {

        background:
            linear-gradient(135deg,
                #212529,
                #343a40);

        color: white;

        border-radius: 20px;

        padding: 3rem;

        margin-bottom: 2.5rem;

        position: relative;

        overflow: hidden;

    }


    .hero-bar::after {

        content: "";

        position: absolute;

        width: 350px;

        height: 350px;

        border-radius: 50%;

        background: rgba(217, 154, 43, .12);

        right: -100px;

        top: -120px;

    }


    .hero-icon {

        font-size: 8rem;

        color: #D99A2B;

        opacity: .18;

        position: relative;

        z-index: 1;

    }


    .hero-title {

        color: #D99A2B;

    }


    /* =========================================================
       CARDS DOS MÓDULOS
       ========================================================= */

    .modulo-card {

        border: none;

        border-radius: 18px;

        overflow: hidden;

        transition: .35s ease;

        cursor: pointer;

        position: relative;

        background-color: white;

    }


    .modulo-card:hover {

        transform: translateY(-8px);

        box-shadow:
            0 1rem 2rem rgba(0, 0, 0, .15) !important;

    }


    /* =========================================================
       BRILHO
       ========================================================= */

    .modulo-card::before {

        content: "";

        position: absolute;

        top: 0;

        left: -120%;

        width: 70%;

        height: 100%;

        background: linear-gradient(120deg,
                transparent,
                rgba(255, 255, 255, .5),
                transparent);

        transition: .8s;

    }


    .modulo-card:hover::before {

        left: 150%;

    }


    /* =========================================================
       ÍCONES
       ========================================================= */

    .modulo-icon {

        font-size: 3.2rem;

        transition: .35s;

    }


    .modulo-card:hover .modulo-icon {

        transform: scale(1.15);

    }


    /* =========================================================
       TÍTULO
       ========================================================= */

    .modulo-card h5 {

        transition: .35s;

    }


    .modulo-card:hover h5 {

        color: #B77A16;

    }


    /* =========================================================
       BLOQUEADO
       ========================================================= */

    .bloqueado {

        opacity: .65;

        cursor: not-allowed;

    }


    .bloqueado:hover {

        transform: none;

        box-shadow:
            0 .5rem 1rem rgba(0, 0, 0, .10) !important;

    }


    .cadeado {

        position: absolute;

        top: 15px;

        right: 15px;

        color: #6c757d;

        font-size: 1.3rem !important;

    }


    /* =========================================================
       DESTAQUE
       ========================================================= */

    .destaque {

        border-left: 4px solid #D99A2B;

    }
</style>


<div class="container py-5">


    @* =========================================================
       BANNER PRINCIPAL
       ========================================================= *@

    <div class="hero-bar shadow">

        <div class="row align-items-center">


            <div class="col-lg-8 position-relative" style="z-index: 2;">


                <div class="mb-2">

                    <span class="badge rounded-pill" style="background-color: #D99A2B;">

                        <i class="bi bi-stars me-1"></i>

                        Sistema de Gerenciamento

                    </span>

                </div>


                <h1 class="display-5 fw-bold">

                    <span class="hero-title">

                        <i class="bi bi-cup-straw me-2"></i>

                        Gerenciamento de Bar

                    </span>

                </h1>


                <p class="lead mt-3 text-light">

                    Controle mesas, garçons, produtos, contas e pedidos
                    de forma simples e organizada.

                </p>


                @if (!logado)
                {

                    <a asp-controller="Autenticacao" asp-action="Entrar"
                       class="btn btn-light rounded-pill px-4 mt-3 fw-semibold">

                        <i class="bi bi-box-arrow-in-right me-2"></i>

                        Entrar no Sistema

                    </a>

                }
                else
                {

                    <p class="mt-3 mb-0">

                        <i class="bi bi-check-circle-fill me-2" style="color: #D99A2B;"></i>

                        Bem-vindo ao painel de gerenciamento.

                    </p>

                }

            </div>


            <div class="col-lg-4 text-center d-none d-lg-block">

                <i class="bi bi-cup-straw hero-icon"></i>

            </div>

        </div>

    </div>



    @* =========================================================
       ALERTA
       ========================================================= *@

    @if (!logado)
    {

        <div class="alert alert-warning shadow-sm">

            <i class="bi bi-info-circle me-2"></i>

            Faça login para acessar os módulos de gerenciamento.

        </div>

    }



    @* =========================================================
       TÍTULO
       ========================================================= *@

    <div class="mb-4">

        <h3 class="fw-bold">

            <i class="bi bi-grid-fill me-2" style="color: #D99A2B;"></i>

            Módulos do Sistema

        </h3>


        <p class="text-muted">

            @if (logado)
            {

                <span>

                    Selecione um módulo para começar.

                </span>

            }
            else
            {

                <span>

                    Conheça os recursos disponíveis no sistema.

                </span>

            }

        </p>

    </div>



    @* =========================================================
       MÓDULOS
       ========================================================= *@

    <div class="row g-4">

        @{

            var modulos = new[]
            {
                new
                {
                    Nome = "Mesas",
                    Icone = "bi-grid-3x3-gap-fill",
                    Cor = "#D99A2B",
                    Controller = "Mesa",
                    Descricao = "Controle das mesas e seus lugares.",
                    Destaque = true
                },

                new
                {
                    Nome = "Garçons",
                    Icone = "bi-person-badge-fill",
                    Cor = "#0D6EFD",
                    Controller = "Garcom",
                    Descricao = "Cadastro e gerenciamento dos garçons.",
                    Destaque = false
                },

                new
                {
                    Nome = "Produtos",
                    Icone = "bi-cup-straw",
                    Cor = "#6F42C1",
                    Controller = "Produto",
                    Descricao = "Cadastro dos produtos disponíveis.",
                    Destaque = false
                },

                new
                {
                    Nome = "Contas",
                    Icone = "bi-cash-stack",
                    Cor = "#198754",
                    Controller = "Conta",
                    Descricao = "Abertura e fechamento das contas.",
                    Destaque = true
                },

                new
                {
                    Nome = "Pedidos",
                    Icone = "bi-receipt-cutoff",
                    Cor = "#FD7E14",
                    Controller = "Pedido",
                    Descricao = "Registro dos pedidos dos clientes.",
                    Destaque = true
                }
            };

        }


        @foreach (var item in modulos)
        {

            <div class="col-xl-4 col-lg-4 col-md-6">


                @if (logado)
                {

                    <a asp-controller="@item.Controller" asp-action="Listar" class="text-decoration-none text-dark">


                        <div class="card modulo-card shadow-sm h-100
                            @(item.Destaque ? "destaque" : "")">


                            <div class="card-body text-center py-4">


                                <i class="bi @item.Icone modulo-icon" style="color: @item.Cor;"></i>


                                <h5 class="mt-3 fw-bold">

                                    @item.Nome

                                </h5>


                                <p class="text-muted mb-0">

                                    @item.Descricao

                                </p>


                            </div>

                        </div>


                    </a>

                }
                else
                {

                    <div class="card modulo-card bloqueado shadow-sm h-100">


                        <i class="bi bi-lock-fill cadeado"></i>


                        <div class="card-body text-center py-4">


                            <i class="bi @item.Icone modulo-icon" style="color: @item.Cor;"></i>


                            <h5 class="mt-3 fw-bold">

                                @item.Nome

                            </h5>


                            <p class="text-muted mb-0">

                                @item.Descricao

                            </p>


                        </div>

                    </div>

                }

            </div>

        }

    </div>



</div>