<<!DOCTYPE html>
    <html lang="pt-BR">

    <head>

        <meta charset="UTF-8">

        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        @* =========================================================
       BOOTSTRAP
       ========================================================= *@

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
              integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">


        @* =========================================================
       BOOTSTRAP ICONS
       ========================================================= *@

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


        @* =========================================================
       IDENTIDADE VISUAL DO BAR
       ========================================================= *@

        <style>
                    :root {

                        --bar-primary: #D99A2B;
                        --bar-primary-hover: #B77A16;

                        --bar-dark: #212529;
                        --bar-dark-light: #343a40;

                        --bar-background: #F8F9FA;

                        --bar-success: #198754;
                        --bar-danger: #DC3545;
                        --bar-info: #0D6EFD;

                    }


                    body {

                        background-color: var(--bar-background);

                    }


                    /* =====================================================
                   NAVBAR
                   ===================================================== */

                    .navbar-bar {

                        background-color: var(--bar-dark);

                    }


                    .navbar-brand {

                        transition: .25s ease;

                    }


                    .navbar-brand:hover {

                        color: var(--bar-primary) !important;

                    }


                    .navbar-brand-icon {

                        color: var(--bar-primary);

                    }


                    /* =====================================================
                   LINKS DA NAVBAR
                   ===================================================== */

                    .navbar-bar .nav-link {

                        color: rgba(255, 255, 255, .85);

                        transition: .25s ease;

                    }


                    .navbar-bar .nav-link:hover {

                        color: var(--bar-primary);

                    }


                    .navbar-bar .nav-link.active {

                        color: var(--bar-primary);

                    }


                    /* =====================================================
                   DROPDOWN
                   ===================================================== */

                    .dropdown-menu {

                        border-radius: 12px;

                    }


                    .dropdown-item {

                        transition: .2s ease;

                    }


                    .dropdown-item:hover {

                        background-color: #f8f9fa;

                        color: var(--bar-primary-hover);

                    }


                    /* =====================================================
                   BOTÃO PRINCIPAL
                   ===================================================== */

                    .btn-bar {

                        background-color: var(--bar-primary);

                        border-color: var(--bar-primary);

                        color: white;

                    }


                    .btn-bar:hover {

                        background-color: var(--bar-primary-hover);

                        border-color: var(--bar-primary-hover);

                        color: white;

                    }


                    /* =====================================================
                   CABEÇALHO
                   ===================================================== */

                    .page-header {

                        border-bottom: 1px solid #dee2e6;

                    }


                    .page-header-title {

                        color: var(--bar-dark);

                    }


                    .page-header-icon {

                        color: var(--bar-primary);

                    }


                    /* =====================================================
                   FOOTER
                   ===================================================== */

                    .footer-bar {

                        background-color: var(--bar-dark);

                        color: rgba(255, 255, 255, .7);

                    }
        </style>


        <title>@ViewBag.Titulo - Gerenciamento de Bar</title>

    </head>


    <body>


        @* =========================================================
       BARRA DE NAVEGAÇÃO
       ========================================================= *@

        <nav class="navbar navbar-expand-lg navbar-dark navbar-bar shadow-sm">

            <div class="container">


                @* =================================================
               LOGO
               ================================================= *@

                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">

                    <i class="bi bi-cup-straw navbar-brand-icon fs-3 me-2"></i>

                    <span>Gerenciamento de Bar</span>

                </a>


                @* =================================================
               BOTÃO MOBILE
               ================================================= *@

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Alternar navegação">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse" id="menuPrincipal">


                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        @* =================================================
                       MENU PRINCIPAL
                       ================================================= *@

                        <ul class="navbar-nav me-auto ms-lg-4">


                            @* INÍCIO *@

                            <li class="nav-item">

                                <a class="nav-link" asp-controller="Home" asp-action="Index">

                                    <i class="bi bi-house-door me-1"></i>

                                    Início

                                </a>

                            </li>


                            @* =================================================
                           CADASTROS
                           ================================================= *@

                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-database me-1"></i>

                                    Cadastros

                                </a>


                                <ul class="dropdown-menu shadow border-0">


                                    <li>

                                        <h6 class="dropdown-header">

                                            <i class="bi bi-folder me-2"></i>

                                            Cadastros

                                        </h6>

                                    </li>


                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>


                                    @* MESAS *@

                                    <li>

                                        <a class="dropdown-item" asp-controller="Mesa" asp-action="Listar">

                                            <i class="bi bi-grid-3x3-gap me-2" style="color: #D99A2B;"></i>

                                            Mesas

                                        </a>

                                    </li>


                                    @* GARÇONS *@

                                    <li>

                                        <a class="dropdown-item" asp-controller="Garcom" asp-action="Listar">

                                            <i class="bi bi-person-badge me-2 text-primary"></i>

                                            Garçons

                                        </a>

                                    </li>


                                    @* PRODUTOS *@

                                    <li>

                                        <a class="dropdown-item" asp-controller="Produto" asp-action="Listar">

                                            <i class="bi bi-cup-straw me-2" style="color: #6F42C1;"></i>

                                            Produtos

                                        </a>

                                    </li>

                                </ul>

                            </li>


                            @* =================================================
                           ATENDIMENTO
                           ================================================= *@

                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-arrow-left-right me-1"></i>

                                    Atendimento

                                </a>


                                <ul class="dropdown-menu shadow border-0">


                                    <li>

                                        <h6 class="dropdown-header">

                                            <i class="bi bi-receipt me-2"></i>

                                            Atendimento

                                        </h6>

                                    </li>


                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>


                                    @* CONTAS *@

                                    <li>

                                        <a class="dropdown-item" asp-controller="Conta" asp-action="Listar">

                                            <i class="bi bi-cash-stack me-2 text-success"></i>

                                            Contas

                                        </a>

                                    </li>


                                    @* PEDIDOS *@

                                    <li>

                                        <a class="dropdown-item" asp-controller="Pedido" asp-action="Listar">

                                            <i class="bi bi-receipt-cutoff me-2" style="color: #FD7E14;"></i>

                                            Pedidos

                                        </a>

                                    </li>

                                </ul>

                            </li>


                            @* =================================================
                           MESAS
                           ================================================= *@

                            <li class="nav-item">

                                <a class="nav-link" asp-controller="Mesa" asp-action="Listar">

                                    <i class="bi bi-grid-3x3-gap me-1"></i>

                                    Mesas

                                </a>

                            </li>

                        </ul>


                        @* =================================================
                       USUÁRIO
                       ================================================= *@

                        <div class="dropdown ms-auto">

                            <button class="btn btn-outline-light rounded-pill dropdown-toggle px-3" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">

                                <i class="bi bi-person-circle me-2"></i>

                                @User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">


                                <li>

                                    <h6 class="dropdown-header">

                                        <i class="bi bi-person me-2"></i>

                                        Minha Conta

                                    </h6>

                                </li>


                                <li>
                                    <hr class="dropdown-divider">
                                </li>


                                <li>

                                    <form asp-controller="Autenticacao" asp-action="Sair" method="post">

                                        <button type="submit" class="dropdown-item text-danger">

                                            <i class="bi bi-box-arrow-right me-2"></i>

                                            Sair

                                        </button>

                                    </form>

                                </li>

                            </ul>

                        </div>

                    }
                    else
                    {

                        @* =================================================
                       USUÁRIO NÃO AUTENTICADO
                       ================================================= *@

                        <div class="ms-auto">

                            <a asp-controller="Autenticacao" asp-action="Entrar"
                               class="btn btn-bar rounded-pill px-4 fw-semibold shadow-sm">

                                <i class="bi bi-box-arrow-in-right me-2"></i>

                                Entrar

                            </a>

                        </div>

                    }

                </div>

            </div>

        </nav>


        @* =========================================================
       CABEÇALHO DA PÁGINA
       ========================================================= *@

        <header class="container py-4 page-header">

            <div>

                <h2 class="fw-bold mb-1 page-header-title">

                    @ViewBag.Titulo

                </h2>


                <p class="text-muted mb-0">

                    <i class="bi bi-cup-straw page-header-icon me-1"></i>

                    Gerenciamento de Bar

                </p>

            </div>

        </header>


        @* =========================================================
       CONTEÚDO
       ========================================================= *@

        <main class="container pb-5">

            @RenderBody()

        </main>


        @* =========================================================
       FOOTER
       ========================================================= *@

        <footer class="footer-bar py-4 mt-4">

            <div class="container text-center">

                <small>

                    <i class="bi bi-cup-straw me-1"></i>

                    Gerenciamento de Bar

                    <span class="mx-2">•</span>

                    Sistema de controle de atendimento

                </small>

            </div>

        </footer>


        @* =========================================================
       BOOTSTRAP JAVASCRIPT
       ========================================================= *@

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous">
        </script>

    </body>

</html>