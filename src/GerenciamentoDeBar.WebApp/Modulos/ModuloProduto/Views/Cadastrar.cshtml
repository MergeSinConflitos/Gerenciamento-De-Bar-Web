@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastrar Produto";
}

@model ProdutoViewModel.CadastrarProdutoViewModel

<div class="container py-4">

    @* =========================================================
       CABEÇALHO
       ========================================================= *@

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-box-seam-fill me-2" style="color: #D99A2B;"></i>

                Cadastrar Produto

            </h3>

            <small class="text-muted">
                Cadastre um novo produto no sistema.
            </small>

        </div>

        <a class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" asp-action="Listar">

            <i class="bi bi-arrow-left me-2"></i>

            Voltar

        </a>

    </div>


    @* =========================================================
       MENSAGEM DE ERRO
       ========================================================= *@

    @if (TempData["MensagemErro"] is string mensagemErro)
    {
        <div class="alert alert-danger
            border-start border-danger border-4
            rounded-3 shadow-sm" role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @mensagemErro

        </div>
    }


    @* =========================================================
       FORMULÁRIO
       ========================================================= *@

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4 p-md-5">

            <div class="d-flex align-items-center mb-4">

                <div class="rounded-circle
                    d-flex
                    align-items-center
                    justify-content-center
                    me-3" style="
                    width: 48px;
                    height: 48px;
                    background-color: rgba(217, 154, 43, .12);
                    color: #D99A2B;">

                    <i class="bi bi-box-seam fs-4"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-0">
                        Dados do Produto
                    </h5>

                    <small class="text-muted">
                        Preencha todos os dados abaixo.
                    </small>

                </div>

            </div>


            <form asp-action="Cadastrar" method="post">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert">
                </div>


                <div class="row g-4">

                    @* =====================================================
                       NOME
                       ===================================================== *@

                    <div class="col-md-8">

                        <label asp-for="Nome" class="form-label fw-semibold">

                            <i class="bi bi-box-seam me-1"></i>

                            Nome

                        </label>

                        <input asp-for="Nome" class="form-control form-control-lg"
                               placeholder="Digite o nome do produto" autocomplete="off" />

                        <span asp-validation-for="Nome" class="text-danger small">
                        </span>

                    </div>


                    @* =====================================================
                       PREÇO
                       ===================================================== *@

                    <div class="col-md-4">

                        <label asp-for="Preco" class="form-label fw-semibold">

                            <i class="bi bi-currency-dollar me-1"></i>

                            Preço

                        </label>

                        <input asp-for="Preco" class="form-control form-control-lg" type="number" step="0.01" min="0.01"
                               placeholder="0,00" />

                        <span asp-validation-for="Preco" class="text-danger small">
                        </span>

                    </div>

                </div>


                @* =========================================================
                   AÇÕES
                   ========================================================= *@

                <div class="border-top pt-4 mt-5">

                    <div class="d-flex
                        flex-column
                        flex-sm-row
                        justify-content-end
                        gap-2">

                        <a asp-action="Listar" class="btn btn-outline-secondary
                            rounded-pill
                            px-4">

                            <i class="bi bi-x-circle me-1"></i>

                            Cancelar

                        </a>


                        <button type="submit" class="btn rounded-pill
                            px-4
                            fw-semibold" style="
                            background-color: #D99A2B;
                            color: white;">

                            <i class="bi bi-check-circle me-1"></i>

                            Salvar

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>
