@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Mesas";
}

@model List<MesaViewModel.ListarMesasViewModel>


<div class="container py-4">

    @* =========================================================
       CABEÇALHO
       ========================================================= *@

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-grid-3x3-gap-fill me-2" style="color: #D99A2B;"></i>

                Mesas

            </h3>


        </div>


        <a class="btn rounded-pill px-4 fw-semibold" style="background-color: #D99A2B; color: white;"
           asp-action="Cadastrar">

            <i class="bi bi-plus-circle me-2"></i>

            Cadastrar Nova Mesa

        </a>

    </div>


    @* =========================================================
       MENSAGEM DE ERRO
       ========================================================= *@

    @if (TempData["MensagemErro"] is string mensagemErro)
    {
        <div class="alert alert-danger
            border-start border-danger border-4
            rounded-3 shadow-sm" role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @mensagemErro

        </div>
    }

    @* =========================================================
   FILTROS
   ========================================================= *@

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-3">

                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 42px;
                    height: 42px;
                    background-color: rgba(217, 154, 43, .12);
                    color: #D99A2B;">

                    <i class="bi bi-search fs-5"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-0">
                        Pesquisar Mesas
                    </h5>

                    <small class="text-muted">
                        Encontre uma mesa pelo número ou filtre pelo status.
                    </small>

                </div>

            </div>


            <form method="get" asp-action="Listar">

                <div class="row g-3 align-items-end">

                    @* =====================================================
                   NÚMERO DA MESA
                   ===================================================== *@

                    <div class="col-md-5">

                        <label for="numeroDaMesa" class="form-label fw-semibold">

                            <i class="bi bi-grid-3x3-gap me-1"></i>

                            Número da Mesa

                        </label>

                        <input type="number" id="numeroDaMesa" name="numeroDaMesa" class="form-control" min="1"
                               placeholder="Digite o número da mesa" />

                    </div>


                    @* =====================================================
                   STATUS
                   ===================================================== *@

                    <div class="col-md-4">

                        <label for="status" class="form-label fw-semibold">

                            <i class="bi bi-circle-fill me-1"></i>

                            Status

                        </label>

                        <select id="status" name="status" class="form-select">

                            <option value="">
                                Todos os status
                            </option>

                            <option value="@StatusMesa.Livre">
                                Livre
                            </option>

                            <option value="@StatusMesa.Ocupada">
                                Ocupada
                            </option>

                        </select>

                    </div>


                    @* =====================================================
                   BOTÕES
                   ===================================================== *@

                    <div class="col-md-3">

                        <div class="d-flex gap-2">

                            <button type="submit" class="btn rounded-pill px-4 flex-grow-1 fw-semibold" style="background-color: #D99A2B;
                                color: white;">

                                <i class="bi bi-search me-1"></i>

                                Pesquisar

                            </button>


                            <a asp-action="Listar" class="btn btn-outline-secondary rounded-pill px-3"
                               title="Limpar filtros">

                                <i class="bi bi-arrow-clockwise"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    @* =========================================================
       LEGENDA DOS STATUS
       ========================================================= *@

    <div class="d-flex flex-wrap gap-3 mb-4">

        <div class="d-flex align-items-center gap-2">

            <span class="rounded-circle bg-success" style="width: 12px; height: 12px;">
            </span>

            <span class="text-muted small">

                Livre

            </span>

        </div>


        <div class="d-flex align-items-center gap-2">

            <span class="rounded-circle bg-danger" style="width: 12px; height: 12px;">
            </span>

            <span class="text-muted small">

                Ocupada

            </span>

        </div>

    </div>


    @* =========================================================
       LISTAGEM VAZIA
       ========================================================= *@

    @if (Model.Count == 0)
    {
        <div class="alert alert-primary
            border-start border-primary border-4
            rounded-3 shadow-sm">

            <i class="bi bi-info-circle-fill me-2"></i>

            Nenhuma mesa cadastrada.

        </div>
    }
    else
    {

        @* =====================================================
           CARDS
           ===================================================== *@

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">

            @foreach (MesaViewModel.ListarMesasViewModel m in Model)
            {

                bool mesaLivre = m.StatusMesa == StatusMesa.Livre;

                string corStatus = mesaLivre
                    ? "success"
                    : "danger";

                string textoStatus = mesaLivre
                    ? "Livre"
                    : "Ocupada";

                string iconeStatus = mesaLivre
                    ? "bi-check-circle-fill"
                    : "bi-person-fill";


                <div class="col">

                    <div class="card h-100 border-0 shadow-sm mesa-card">

                        @* INDICADOR LATERAL DO STATUS *@

                        <div class="position-absolute top-0 start-0
                            h-100 bg-@corStatus" style="width: 5px;
                            border-radius: 18px 0 0 18px;">
                        </div>


                        <div class="card-body p-4">

                            @* =================================================
                               CABEÇALHO DO CARD
                               ================================================= *@

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                gap-3 mb-4">

                                <div>

                                    <span class="text-muted small">

                                        <i class="bi bi-grid-3x3-gap me-1"></i>

                                        MESA

                                    </span>

                                    <h4 class="fw-bold mb-0 mt-1">

                                        @m.NumeroDaMesa

                                    </h4>

                                </div>


                                <span class="badge
                                    text-bg-@corStatus
                                    rounded-pill px-3 py-2">

                                    <i class="bi @iconeStatus me-1"></i>

                                    @textoStatus

                                </span>

                            </div>


                            @* =================================================
                               INFORMAÇÕES
                               ================================================= *@

                            <div class="mb-4">

                                <div class="d-flex
                                    align-items-center
                                    justify-content-between
                                    mb-3">

                                    <span class="text-secondary">

                                        <i class="bi bi-people-fill me-2"></i>

                                        Lugares

                                    </span>

                                    <strong>

                                        @m.QuantidadeDeLugares

                                    </strong>

                                </div>


                                <div class="d-flex
                                    align-items-center
                                    justify-content-between">

                                    <span class="text-secondary">

                                        <i class="bi bi-circle-fill me-2
                                        text-@corStatus"></i>

                                        Status

                                    </span>

                                    <strong class="text-@corStatus">

                                        @textoStatus

                                    </strong>

                                </div>

                            </div>


                            @* =================================================
                               IDENTIFICAÇÃO
                               ================================================= *@

                            <div class="border-top pt-3 mb-3">

                                <small class="text-muted">

                                    ID

                                </small>

                                <div class="text-muted small text-break">

                                    @m.Id

                                </div>

                            </div>


                            @* =================================================
                               AÇÕES
                               ================================================= *@

                            <div class="d-flex
                                flex-wrap
                                gap-2
                                justify-content-end">

                                <a class="btn btn-outline-primary
                                    btn-sm rounded-pill px-3" asp-action="Editar" asp-route-id="@m.Id">

                                    <i class="bi bi-pencil me-1"></i>

                                    Editar

                                </a>


                                <a class="btn btn-outline-danger
                                    btn-sm rounded-pill px-3" asp-action="Excluir" asp-route-id="@m.Id">

                                    <i class="bi bi-trash me-1"></i>

                                    Excluir

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    }

</div>


<style>
    /* =========================================================
       CARDS DE MESA
       ========================================================= */

    .mesa-card {

        border-radius: 18px;

        overflow: hidden;

        position: relative;

        transition: .35s ease;

        background-color: white;

    }


    .mesa-card:hover {

        transform: translateY(-7px);

        box-shadow:
            0 1rem 2rem rgba(0, 0, 0, .14) !important;

    }


    /* =========================================================
       BRILHO NO HOVER
       ========================================================= */

    .mesa-card::after {

        content: "";

        position: absolute;

        top: 0;

        left: -120%;

        width: 70%;

        height: 100%;

        background: linear-gradient(120deg,
                transparent,
                rgba(255, 255, 255, .5),
                transparent);

        transition: .8s;

        pointer-events: none;

    }


    .mesa-card:hover::after {

        left: 150%;

    }
</style>