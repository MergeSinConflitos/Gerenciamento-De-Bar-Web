@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastrar Mesa";
}

@model MesaViewModel.CadastrarMesaViewModel


<div class="container py-4">

    @* =========================================================
       CABEÇALHO
       ========================================================= *@

    <div class="mb-4">

        <div class="d-flex align-items-center gap-2 mb-2">

            <a asp-action="Listar" class="btn btn-outline-secondary btn-sm rounded-pill">

                <i class="bi bi-arrow-left me-1"></i>

                Voltar

            </a>

        </div>


        <h3 class="fw-bold mb-1">

            <i class="bi bi-grid-3x3-gap-fill me-2" style="color: #D99A2B;"></i>

            Cadastrar Mesa

        </h3>


        <p class="text-muted mb-0">

            Informe os dados da nova mesa.

        </p>

    </div>


    @* =========================================================
       FORMULÁRIO
       ========================================================= *@

    <div class="row justify-content-center">

        <div class="col-lg-7 col-xl-6">

            <div class="card border-0 shadow-sm cadastro-card">

                <div class="card-body p-4 p-md-5">

                    <form asp-action="Cadastrar" method="post">

                        @* =================================================
                           ERROS GERAIS
                           ================================================= *@

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger
                            border-start border-danger border-4
                            rounded-3" role="alert">
                        </div>


                        @* =================================================
                           NÚMERO DA MESA
                           ================================================= *@

                        <div class="mb-4">

                            <label asp-for="NumeroDaMesa" class="form-label fw-semibold">

                                <i class="bi bi-grid-3x3-gap me-1" style="color: #D99A2B;"></i>

                                Número da Mesa

                            </label>


                            <input asp-for="NumeroDaMesa" class="form-control form-control-lg" type="number" min="1"
                                   placeholder="Ex.: 1" />


                            <span asp-validation-for="NumeroDaMesa" class="text-danger small">
                            </span>


                            <div class="form-text">

                                Informe um número inteiro positivo.

                            </div>

                        </div>


                        @* =================================================
                           QUANTIDADE DE LUGARES
                           ================================================= *@

                        <div class="mb-4">

                            <label asp-for="QuantidadeDeLugares" class="form-label fw-semibold">

                                <i class="bi bi-people-fill me-1" style="color: #D99A2B;"></i>

                                Quantidade de Lugares

                            </label>


                            <input asp-for="QuantidadeDeLugares" class="form-control form-control-lg" type="number"
                                   min="1" max="10" placeholder="Ex.: 4" />


                            <span asp-validation-for="QuantidadeDeLugares" class="text-danger small">
                            </span>


                            <div class="form-text">

                                A mesa pode possuir de 1 a 10 lugares.

                            </div>

                        </div>


                        @* =================================================
                           STATUS
                           ================================================= *@

                        <div class="alert alert-light border rounded-3 mb-4">

                            <div class="d-flex align-items-center gap-3">

                                <div class="text-success">

                                    <i class="bi bi-check-circle-fill fs-4"></i>

                                </div>

                                <div>

                                    <strong>Status inicial</strong>

                                    <div class="text-muted small">

                                        A mesa será cadastrada como
                                        <strong class="text-success">
                                            Livre
                                        </strong>.

                                    </div>

                                </div>

                            </div>

                        </div>


                        @* =================================================
                           BOTÕES
                           ================================================= *@

                        <div class="d-flex
                            flex-column flex-sm-row
                            justify-content-end
                            gap-2
                            pt-2">

                            <a asp-action="Listar" class="btn btn-outline-secondary
                                rounded-pill px-4">

                                <i class="bi bi-x-circle me-1"></i>

                                Cancelar

                            </a>


                            <button type="submit" class="btn rounded-pill px-4 fw-semibold" style="background-color: #D99A2B;
                                color: white;">

                                <i class="bi bi-check-circle me-1"></i>

                                Salvar

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<style>
    /* =========================================================
       CARD DO FORMULÁRIO
       ========================================================= */

    .cadastro-card {

        border-radius: 18px;

        overflow: hidden;

        position: relative;

    }


    /* =========================================================
       CAMPOS
       ========================================================= */

    .form-control {

        border-radius: 10px;

    }


    .form-control:focus {

        border-color: #D99A2B;

        box-shadow:
            0 0 0 .2rem rgba(217, 154, 43, .15);

    }


    /* =========================================================
       BOTÃO PRINCIPAL
       ========================================================= */

    button[type="submit"] {

        transition: .25s ease;

    }


    button[type="submit"]:hover {

        background-color: #B77A16 !important;

        transform: translateY(-2px);

    }
</style>
